# Firebase Emuladores
USE_FIREBASE_EMULATORS=true
FIREBASE_EMULATOR_HOST=localhost

# Firebase Projeto (referência — não afeta o app, apenas documentação)
FIREBASE_PROJECT_ID=ativamente-dev-seuusuario

# Porta do app web (usado no flutter run)
APP_WEB_PORT=3000

# Credenciais de Seed para desenvolvimento local (opcional)
# SEED_ADMIN_EMAIL=ativamente@ativamente.org
# SEED_ADMIN_PASSWORD=dev123456
# SEED_TRAINER_EMAIL=personal@ativamente.org
# SEED_TRAINER_PASSWORD=dev123456

